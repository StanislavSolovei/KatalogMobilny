<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KatalogMobilny.NewProduktPage"
             Title="NewProduktPage">
    <Grid RowDefinitions="Auto,*,Auto" Padding="20">
        <Label 
            Grid.Row="0"
            FontSize="24"
            Text="Nowy produkt"
            VerticalOptions="Center" 
            HorizontalOptions="Center"/>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Nazwa"/>
                    <Entry HeightRequest="44" x:Name="NazwaEntry" Placeholder="Wpisz nazwę produktu"/>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="8">
                    <Label Text="Cena"/>
                    <Entry HeightRequest="44" x:Name="CenaEntry" Placeholder="0" Keyboard="Numeric"/>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="8">
                    <Label Text="Kategoria"/>
                    <Picker HeightRequest="44" x:Name="KategoriaPicker">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Procesory</x:String>
                                <x:String>Płyty główne</x:String>
                                <x:String>Karty graficzne</x:String>
                                <x:String>Dyski SSD</x:String>
                                <x:String>Pamięci RAM</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </VerticalStackLayout>
                <HorizontalStackLayout>
                    <Switch HeightRequest="44" x:Name="AvailableSwitch"/>
                    <Label Text="Produkt dostępny" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <VerticalStackLayout Grid.Row="2" Spacing="10">
            <Button HeightRequest="52" Text="Dodaj produkty" Clicked="NowyProdukt_Clicked"/>
            <Button HeightRequest="52" Text="Resetuj produkty" Clicked="NowyProdukt_Reset"/>
            <Label x:Name="EtykietaWyniku"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>