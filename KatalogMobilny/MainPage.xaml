<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KatalogMobilny.MainPage">
    <!-- całość zamykamy w znaczniku grid -->
    <Grid>
        <!-- definijuemy ile jest wierszy i kolumn-->
        <Grid.RowDefinitions>
            <!-- zdecydujemy się na 5 wierszy -->
            <RowDefinition Height="Auto"/> 
            <!-- * oznacza, że wiersz zajmie pozostałą dostępna przestrzeń -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- zdecydjumey się na 2 kolumny identycznej szekości -->
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
    </Grid>

